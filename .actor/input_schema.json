{
    "title": "CineScore Universe Rating Sorter Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "mediaCategory": {
            "title": "Media Universe Category",
            "type": "string",
            "description": "Select the universe format: All Media Universe, Top 100 Movies, Top 100 TV Series, Top 100 Anime Series, Top Anime Movies, Top 100 Cartoons, Top 100 Animated Feature Films, or Hall of Fame Legendary Episodes.",
            "default": "All Media Universe",
            "editor": "select",
            "enum": [
                "All Media Universe",
                "🎬 Top 100 Movies",
                "📺 Top 100 TV Series",
                "🎌 Top 100 Anime Series",
                "🎌 Top Anime Movies",
                "🎨 Top 100 Cartoons",
                "🎨 Top 100 Animated Feature Films",
                "🏆 Hall of Fame Legendary Episodes"
            ]
        },
        "mode": {
            "title": "Operation Mode",
            "type": "string",
            "description": "Select whether to explore the curated Universe Catalog or parse your own custom list of titles.",
            "default": "Universe Catalog & Top Rankings",
            "editor": "select",
            "enum": [
                "Universe Catalog & Top Rankings",
                "Parse Custom Movie List"
            ]
        },
        "rawMovieTitles": {
            "title": "Custom Media Titles (One per line)",
            "type": "string",
            "description": "Used when mode is 'Parse Custom Movie List'. Paste titles like:\n1. Breaking Bad\n2. Attack on Titan\n3. Spirited Away\n4. Avatar: The Last Airbender",
            "editor": "textarea",
            "default": "Breaking Bad\nAttack on Titan\nSpirited Away\nThe Dark Knight\nAvatar: The Last Airbender\nOzymandias\nArcane\nFullmetal Alchemist: Brotherhood\nSpider-Man: Across the Spider-Verse\nSuccession"
        },
        "sortBy": {
            "title": "Sort Criterion",
            "type": "string",
            "description": "Metric to rank items by.",
            "default": "CineScore (0-100)",
            "editor": "select",
            "enum": [
                "CineScore (0-100)",
                "IMDb Rating (0-10)",
                "MyAnimeList (MAL Score)",
                "Rotten Tomatoes (%)",
                "Metacritic Score (0-100)",
                "Letterboxd (0-5)",
                "Release Year",
                "Box Office ($M)",
                "Oscar Wins",
                "Seasons Count",
                "Episodes Count"
            ]
        },
        "ascending": {
            "title": "Ascending Order",
            "type": "boolean",
            "description": "Sort in ascending order (default is False: highest rating first).",
            "default": false
        },
        "genreFilter": {
            "title": "Genre Filter",
            "type": "string",
            "description": "Filter by cinematic genre or 'All Genres'.",
            "default": "All Genres",
            "editor": "select",
            "enum": [
                "All Genres",
                "Action",
                "Adventure",
                "Animation",
                "Anime",
                "Biography",
                "Comedy",
                "Crime",
                "Documentary",
                "Drama",
                "Fantasy",
                "History",
                "Horror",
                "Mystery",
                "Romance",
                "Sci-Fi",
                "Thriller",
                "War",
                "Western"
            ]
        },
        "minImdb": {
            "title": "Minimum IMDb Rating",
            "type": "number",
            "description": "Lower threshold for IMDb rating (0.0 to 10.0).",
            "default": 0.0,
            "minimum": 0.0,
            "maximum": 10.0
        },
        "minYear": {
            "title": "Minimum Release Year",
            "type": "integer",
            "description": "Earliest release year.",
            "default": 1930,
            "minimum": 1900,
            "maximum": 2026
        },
        "maxYear": {
            "title": "Maximum Release Year",
            "type": "integer",
            "description": "Latest release year.",
            "default": 2026,
            "minimum": 1900,
            "maximum": 2026
        },
        "searchQuery": {
            "title": "Search Query (Title, Director, Studio, Creator)",
            "type": "string",
            "description": "Optional keyword search filter.",
            "default": "",
            "editor": "textfield"
        },
        "apiKey": {
            "title": "Apify API Token / Custom Key",
            "type": "string",
            "description": "Optional Apify API token or custom authentication key for MCP and programmatic triggers.",
            "editor": "textfield"
        }
    }
}
